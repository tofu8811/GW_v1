# Application
APP_NAME=gateway-api
APP_ENV=development
APP_PORT=8080
GATEWAY_NODE=gateway-api-1
# Comma-separated proxy IPs/CIDRs allowed to provide X-Forwarded-For.
# Keep empty unless client IP-aware middleware needs the real client IP behind Caddy.
TRUSTED_PROXIES=
# Compose mounts this Caddyfile. Use ../Caddyfile.prod for a real domain.
CADDY_CONFIG_FILE=../Caddyfile.local
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gateway_db
POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=gateway_password
DATABASE_URL=postgres://gateway_user:gateway_password@localhost:5432/gateway_db?sslmode=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Config cache loader
CONFIG_SCHEMA_VERSION=2
CONFIG_POLL_INTERVAL_SECONDS=20
CONFIG_TTL_SECONDS=0
CONFIG_REBUILD_LOCK_TTL_SECONDS=10
CONFIG_REBUILD_LOCK_WAIT_SECONDS=2

# Upstream health checks
HEALTH_CHECK_INTERVAL=10s
HEALTH_PROBE_TIMEOUT=2s
HEALTH_UNHEALTHY_THRESHOLD=3
HEALTH_HEALTHY_THRESHOLD=2
HEALTH_KEY_TTL=30s

# Upstream circuit breaker
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_TIMEOUT=15s
BREAKER_HALFOPEN_MAX=1

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Auth
JWT_SECRET=change_me_in_local_env
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/gateway.jsonl

# RabbitMQ
RABBITMQ_DEFAULT_USER=gateway
RABBITMQ_DEFAULT_PASS=gateway_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://gateway:gateway_password@localhost:5672/
RABBITMQ_LOG_EXCHANGE=gateway.logs.exchange
RABBITMQ_LOG_QUEUE=gateway.logs.queue
RABBITMQ_LOG_ROUTING_KEY=gateway.request.completed
RABBITMQ_LOG_DLX=gateway.logs.dlx
RABBITMQ_LOG_DLQ=gateway.logs.dlq
RABBITMQ_PUBLISH_TIMEOUT=500ms

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_LOG_INDEX_PREFIX=gateway-logs

# Log service
LOG_SERVICE_PORT=8082
LOG_CONSUMER_BATCH_SIZE=500
LOG_CONSUMER_FLUSH_INTERVAL=1s
LOG_CONSUMER_PREFETCH=100
